# ─────────────────────────────────────────────────────────────────────────────
# AbodeSpot — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your Supabase credentials below
#   3. Run: npm run dev
#
# VERCEL DEPLOYMENT:
#   Do NOT commit your .env file. Instead, add these variables in:
#   Vercel Dashboard → Your Project → Settings → Environment Variables
#
#   Required variables:
#     VITE_SUPABASE_URL     → Your project URL
#     VITE_SUPABASE_ANON_KEY → Your project publishable/anon public key
#
#   Get these from: https://supabase.com → Your Project → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here
